      <!-- Script Slick carousel -->
      <script src="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
      <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
      <script>
        // Slick Slider
        $('.multiple-items').slick({
          infinite: true,
          dots: true,
          slidesToShow: 1,
          slidesToScroll: 1,
          prevArrow:"<img class='a-left control-c prev slick-prev' src='https://www.esplanadajau.com.br/wp-content/themes/c4themeEsplanada/img/prev.webp' alt='Image de seta apontando para a esquerda'>",
          nextArrow:"<img class='a-right control-c next slick-next' src='https://www.esplanadajau.com.br/wp-content/themes/c4themeEsplanada/img/next.webp' alt='Image de seta apontando para a direita'>"
        });
        $('.multiple-items2').slick({
          infinite: true,
          dots: true,
          slidesToShow: 1,
          slidesToScroll: 1,        
        });
        $(document).ready(function(){
          $(".owl-carousel").owlCarousel({
            items: 1,
            loop: true,
            autoplay: true,
            autoplayTimeout: 3000,
            nav: false,
            dots: true
          });
        });      

		  // Obtém o botão e a div da frase
			var meuBotao = document.getElementById('meuBotao');
			var fraseDiv = document.getElementById('fraseDiv');
			// Adiciona um ouvinte de eventos para o evento 'mouseover'
			meuBotao.addEventListener('mouseover', function() {
				// Adiciona a classe 'show' à div da frase ao passar o mouse
				fraseDiv.classList.add('show');
			});
			// Adiciona um ouvinte de eventos para o evento 'mouseout'
			meuBotao.addEventListener('mouseout', function() {
				// Remove a classe 'show' da div da frase ao tirar o mouse
				fraseDiv.classList.remove('show');
			});

      //fecha o menu após clicar em uma opção
      document.addEventListener('DOMContentLoaded', function () {
        const navLinks = document.querySelectorAll('.menu_nav_uncollapse');
        const navbarCollapse = document.querySelector('.navbar-collapse');

        navLinks.forEach(function (link) {
          link.addEventListener('click', function () {
            const bsCollapse = new bootstrap.Collapse(navbarCollapse, {
              toggle: false
            });
            bsCollapse.hide(); // Fecha o menu
            console.log("menu fechado")
          });
        });
      });

      document.addEventListener('click', function (event) {
        const navbar = document.querySelector('.navbar');
        const navbarCollapse = document.querySelector('.navbar-collapse');
        const isClickInsideNavbar = navbar.contains(event.target);

        // Verifica se o menu está aberto
        const isExpanded = navbarCollapse.classList.contains('show');

        if (!isClickInsideNavbar && isExpanded) {
          const bsCollapse = new bootstrap.Collapse(navbarCollapse, {
            toggle: false
          });
          bsCollapse.hide(); // Fecha o menu
        }
      });
      </script>
